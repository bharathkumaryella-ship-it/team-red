# Copy to .env and replace placeholders with generated local values.
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters

# Set DATABASE_URL to a MySQL SQLAlchemy URL, or configure all MYSQL_* values below.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=medidesk
MYSQL_USER=medidesk_app
MYSQL_PASSWORD=replace-with-a-local-database-password

# Comma-separated exact origins; do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_CONTENT_LENGTH=1048576
LOG_LEVEL=INFO
RATELIMIT_STORAGE_URI=redis://redis:6379/0
TRUSTED_PROXY_HOPS=0
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
