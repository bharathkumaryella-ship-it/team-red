# Copy to .env for local Compose use and replace every replace-* value.
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key outside source control and retain old keys during rotation.
PHI_ENCRYPTION_KEYS=replace-with-a-generated-fernet-key
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=medidesk
MYSQL_USER=medidesk_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
CORS_ALLOWED_ORIGINS=https://replace-with-frontend-domain
NEXT_PUBLIC_API_URL=https://replace-with-backend-domain
RATELIMIT_STORAGE_URI=redis://redis:6379/0
MAX_CONTENT_LENGTH=6291456
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=30
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
BACKEND_BIND_ADDRESS=127.0.0.1
